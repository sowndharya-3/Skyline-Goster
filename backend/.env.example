# Backend environment configuration (production template).
# Copy to .env on the server and fill in real values. Never commit the real .env file.

# --- Database (PostgreSQL) ---
# DB_HOST/PORT/NAME/USER/PASSWORD are reference values only — this app reads DATABASE_URL
# directly (no shell-style expansion happens), so build DATABASE_URL from them by hand:
#   postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=ghoster
DB_USER=ghoster
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://ghoster:change-me@your-db-host:5432/ghoster

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-64-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=https://yourdomain.com

# --- Server (used by gunicorn_conf.py) ---
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info
