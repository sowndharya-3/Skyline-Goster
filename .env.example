# Frontend environment configuration (production template).
# Copy to .env.production (or .env) and fill in real values before `npm run build`.

# Base origin the frontend calls for the backend API — every API call in the app already
# appends its own /api/... path (see src/api.ts), so do NOT include /api here.
# Nginx reverse-proxies https://yourdomain.com/api/* to the backend on this same domain.
VITE_API_URL=https://yourdomain.com
